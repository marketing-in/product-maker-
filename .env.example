# Copy this file to .env and fill in your key. Never commit .env.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Only needed for user-scoped keys (sk-ant-usr…): the workspace ID from
# console.anthropic.com → Settings → Workspaces (looks like wrkspc_…).
# Leave empty for a normal workspace API key (sk-ant-api03-…).
ANTHROPIC_WORKSPACE_ID=

# Model used for planning and design.
CLAUDE_MODEL=claude-fable-5-2

# How hard the model thinks on a full design: low, medium or high. Higher is slower and costs more.
CLAUDE_EFFORT=medium

# Port for the local API (the web app proxies /api to it in development).
PORT=8787

# Optional. rea launcher, if it is not on PATH as "rea".
# REA_COMMAND=/absolute/path/to/rea
